@model ClinicaDental.Models.ViewModels.FichaViewModel

@{
    var p = Model.Paciente;
    var esOdontologo = Model.PuedeEditar;
    ViewData["Title"] = esOdontologo ? $"Ficha de {p.Usuario!.NombreCompleto}" : "Mi historia clínica";
    ViewData["TamanoModal"] = "modal-lg";
}

@Html.AntiForgeryToken()

<div class="encabezado-pagina">
    <div>
        <h2>@(esOdontologo ? "Ficha clínica" : "Mi historia clínica")</h2>
        <p>@(esOdontologo ? "Consultas, odontograma y archivos del paciente." : "Tus consultas, el estado de tus piezas y tus estudios.")</p>
    </div>
    @if (esOdontologo)
    {
        <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left"></i> Mis pacientes</a>
    }
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <span class="avatar avatar-grande" aria-hidden="true">@p.Usuario!.Nombre[..1].ToUpperInvariant()</span>
                <div>
                    <h4 class="mb-0">@p.Usuario.NombreCompleto</h4>
                    <div class="text-muted small">
                        @Model.Edad años · DNI @p.Usuario.Dni · @(p.ObraSocial?.Nombre ?? "Particular")@if (!string.IsNullOrEmpty(p.NumeroAfiliado)) { <text> (afiliado @p.NumeroAfiliado)</text> }
                        @if (!string.IsNullOrEmpty(p.Usuario.PhoneNumber)) { <text> · </text><i class="bi bi-telephone"></i> @p.Usuario.PhoneNumber }
                    </div>
                </div>
            </div>
            @if (esOdontologo)
            {
                <button type="button" class="btn btn-primary"
                        onclick="Crud.abrir('@Url.Action("Formulario", "Mensajes", new { pacienteId = p.Id })')">
                    <i class="bi bi-chat-dots"></i> Enviar mensaje
                </button>
            }
        </div>
        @if (!string.IsNullOrEmpty(p.Alergias))
        {
            <div class="alert alert-warning d-flex align-items-start gap-2 mt-3 mb-0" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <div><strong>Alergias / condiciones relevantes:</strong> @p.Alergias</div>
            </div>
        }
    </div>
</div>

<div class="d-flex flex-wrap gap-2 mb-4" aria-label="Secciones de la ficha">
    <a class="btn btn-sm btn-outline-primary" href="#consultas">Consultas</a>
    <a class="btn btn-sm btn-outline-primary" href="#odontograma">Odontograma</a>
    <a class="btn btn-sm btn-outline-primary" href="#archivos">Archivos</a>
</div>

<div id="contenedorFicha">
    <partial name="_FichaContenidoPartial" model="Model" />
</div>

<partial name="_ModalCrud" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        Crud.init({
            modalId: 'modalCrud', tablaId: 'contenedorFicha', entidad: 'archivo',
            eliminarUrl: '@Url.Action("EliminarAdjunto", "Ficha")',
            listarUrl: '@Url.Action("ContenidoPartial", "Ficha", new { id = p.Id })',
            alAbrir: Clinica.alAbrir
        });
    </script>
}
