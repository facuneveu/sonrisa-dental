@model IEnumerable<ClinicaDental.Models.ViewModels.PacienteDelOdontologo>

<table class="table table-hover mb-0">
    <thead>
        <tr>
            <th>Paciente</th>
            <th>Obra social</th>
            <th>Última consulta</th>
            <th>Próximo turno</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>
                    <div class="fw-semibold">@p.Nombre</div>
                    <div class="small text-muted">@p.Edad años · @p.Turnos turno@(p.Turnos == 1 ? "" : "s")</div>
                    @if (!string.IsNullOrEmpty(p.Alergias)) { <span class="badge bg-warning mt-1"><i class="bi bi-exclamation-triangle"></i> @p.Alergias</span> }
                </td>
                <td>@p.ObraSocial</td>
                <td class="text-nowrap">@(p.UltimaConsulta is { } u ? Formato.Fecha(u) : "—")</td>
                <td class="text-nowrap">@(p.ProximoTurno is { } n ? $"{Formato.Fecha(n)} {n:HH:mm}" : "—")</td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-primary" asp-action="Detalle" asp-route-id="@p.Id" title="Abrir ficha" aria-label="Abrir ficha de @p.Nombre">
                        <i class="bi bi-folder2-open"></i> Abrir ficha
                    </a>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="5" class="text-center text-muted py-4">Todavía no tenés pacientes con turnos.</td></tr>
        }
    </tbody>
</table>
