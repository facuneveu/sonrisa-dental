@model IEnumerable<Especialidad>

<table class="table table-hover mb-0">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th class="text-center">Tratamientos</th>
            <th class="text-center">Odontólogos</th>
            <th>Auditoría</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="fw-semibold">@item.Nombre</td>
                <td class="text-muted">@(item.Descripcion ?? "—")</td>
                <td class="text-center"><span class="badge bg-info">@item.Tratamientos.Count</span></td>
                <td class="text-center"><span class="badge bg-info">@item.Odontologos.Count</span></td>
                <td><partial name="_CeldaAuditoria" model="item" /></td>
                <td class="text-end text-nowrap">
                    <button class="btn btn-sm btn-outline-warning me-1" title="Editar" aria-label="Editar"
                            onclick="Crud.abrir('@Url.Action("ObtenerFormulario", "Especialidades", new { id = item.Id })')">
                        <i class="bi bi-pencil"></i><span class="texto-accion"> Editar</span>
                    </button>
                    <button class="btn btn-sm btn-outline-danger" title="Eliminar" aria-label="Eliminar"
                            data-nombre="@item.Nombre"
                            onclick="Crud.eliminar(@item.Id, this.dataset.nombre)">
                        <i class="bi bi-trash"></i><span class="texto-accion"> Eliminar</span>
                    </button>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="6" class="text-center text-muted py-4">No se encontraron especialidades.</td></tr>
        }
    </tbody>
</table>
