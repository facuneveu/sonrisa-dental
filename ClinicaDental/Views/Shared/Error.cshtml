@model ErrorViewModel
@{
    ViewData["Title"] = "Algo salió mal";
}

<div class="card mx-auto" style="max-width: 560px">
    <div class="card-body text-center py-5">
        <div class="display-5 text-danger mb-3"><i class="bi bi-exclamation-triangle"></i></div>
        <h2>Algo salió mal</h2>
        <p class="text-muted">No pudimos completar lo que pediste. Probá de nuevo en unos instantes; si el problema sigue, avisá a la clínica.</p>
        @if (Model.ShowRequestId)
        {
            <p class="small text-muted mb-4">Código de referencia: <code>@Model.RequestId</code></p>
        }
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i> Volver al inicio</a>
    </div>
</div>
