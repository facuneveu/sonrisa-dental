@model IEnumerable<Tratamiento>
@{
    var esAdmin = User.IsInRole(Roles.Administrador);
    var puedeReservar = esAdmin || User.IsInRole(Roles.Paciente);
    var columnas = 4 + (esAdmin ? 2 : 0) + (puedeReservar ? 1 : 0);
}

<table class="table table-hover mb-0">
    <thead>
        <tr>
            <th>Tratamiento</th>
            <th>Especialidad</th>
            <th>Duración</th>
            <th>Precio</th>
            @if (esAdmin)
            {
                <th>Estado</th>
                <th>Auditoría</th>
            }
            @if (puedeReservar)
            {
                <th class="text-end">Acciones</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <div class="fw-semibold">@item.Nombre</div>
                    @if (!string.IsNullOrEmpty(item.Descripcion)) { <div class="small text-muted">@item.Descripcion</div> }
                </td>
                <td>@item.Especialidad?.Nombre</td>
                <td class="text-nowrap">@item.DuracionMinutos min</td>
                <td class="fw-semibold text-nowrap">@Formato.Moneda(item.Precio)</td>
                @if (esAdmin)
                {
                    <td>
                        @if (item.Activo) { <span class="badge bg-success">Disponible</span> }
                        else { <span class="badge bg-secondary">No disponible</span> }
                    </td>
                    <td><partial name="_CeldaAuditoria" model="item" /></td>
                }
                @if (puedeReservar)
                {
                    <td class="text-end text-nowrap">
                        @* Atajo a la reserva con este tratamiento ya elegido *@
                        @if (item.Activo)
                        {
                            <a class="btn btn-sm btn-primary @(esAdmin ? "me-1" : "")" title="Sacar turno" aria-label="Sacar turno de @item.Nombre"
                               asp-controller="Turnos" asp-action="Index" asp-route-nuevo="true" asp-route-tratamientoId="@item.Id">
                                <i class="bi bi-calendar-plus"></i><span class="@(esAdmin ? "texto-accion" : "")"> Sacar turno</span>
                            </a>
                        }
                        @if (esAdmin)
                        {
                            <button class="btn btn-sm btn-outline-warning me-1" title="Editar" aria-label="Editar"
                                    onclick="Crud.abrir('@Url.Action("ObtenerFormulario", "Tratamientos", new { id = item.Id })')">
                                <i class="bi bi-pencil"></i><span class="texto-accion"> Editar</span>
                            </button>
                            <button class="btn btn-sm btn-outline-danger" title="Eliminar" aria-label="Eliminar"
                                    data-nombre="@item.Nombre"
                                    onclick="Crud.eliminar(@item.Id, this.dataset.nombre)">
                                <i class="bi bi-trash"></i><span class="texto-accion"> Eliminar</span>
                            </button>
                        }
                    </td>
                }
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="@columnas" class="text-center text-muted py-4">No se encontraron tratamientos con ese filtro.</td></tr>
        }
    </tbody>
</table>
