@model Tratamiento
@{
    var duraciones = Enumerable.Range(1, 16).Select(i => i * 15)
        .Select(m => new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem($"{m} minutos", m.ToString()));
}

<div class="modal-header bg-primary text-white">
    <h5 class="modal-title text-white">@(Model.Id == 0 ? "Nuevo tratamiento" : "Editar tratamiento")</h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
</div>

<form id="formTratamiento" asp-action="Guardar" asp-controller="Tratamientos" method="post" onsubmit="Crud.guardar(event)">
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="Id" />

        <div class="form-floating mb-3">
            <input asp-for="Nombre" class="form-control" placeholder="Nombre" />
            <label asp-for="Nombre"></label>
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="form-floating mb-3">
            <select asp-for="EspecialidadId" asp-items="@((IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Especialidades)" class="form-select">
                <option value="0">-- Seleccioná una especialidad --</option>
            </select>
            <label asp-for="EspecialidadId"></label>
            <span asp-validation-for="EspecialidadId" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-floating mb-3">
                    <select asp-for="DuracionMinutos" asp-items="duraciones" class="form-select"></select>
                    <label asp-for="DuracionMinutos"></label>
                    <span asp-validation-for="DuracionMinutos" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating mb-3">
                    <input asp-for="Precio" type="number" step="0.01" min="0" class="form-control" placeholder="Precio" />
                    <label asp-for="Precio"></label>
                    <span asp-validation-for="Precio" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="form-floating mb-3">
            <textarea asp-for="Descripcion" class="form-control" placeholder="Descripción" style="height: 100px"></textarea>
            <label asp-for="Descripcion"></label>
            <span asp-validation-for="Descripcion" class="text-danger"></span>
        </div>

        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" asp-for="Activo" role="switch" />
            <label class="form-check-label" asp-for="Activo"></label>
            <div class="form-text">Si no está disponible, los pacientes no lo ven ni pueden reservarlo.</div>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-success"><i class="bi bi-check-circle"></i> Guardar</button>
    </div>
</form>
