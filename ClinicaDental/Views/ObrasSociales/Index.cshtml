@model IEnumerable<ObraSocial>

@{
    ViewData["Title"] = "Obras sociales";
}

@Html.AntiForgeryToken()

<div class="encabezado-pagina">
    <div>
        <h2>Obras sociales</h2>
        <p>Prepagas y obras sociales con las que trabaja la clínica.</p>
    </div>
    <button type="button" class="btn btn-primary"
            onclick="Crud.abrir('@Url.Action("ObtenerFormulario", "ObrasSociales", new { id = 0 })')">
        <i class="bi bi-plus-lg"></i> Nueva obra social
    </button>
</div>

<div class="row g-2 mb-3">
    <div class="col-md-6">
        <input id="filtroTexto" type="search" class="form-control" placeholder="Buscar por nombre o cobertura..." aria-label="Buscar obra social" />
    </div>
    <div class="col-md-3">
        <select id="filtroEstado" class="form-select" aria-label="Filtrar por convenio">
            <option value="">Todas</option>
            <option value="activas">Con convenio vigente</option>
            <option value="inactivas">Sin convenio</option>
        </select>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0" id="contenedorTabla">
        <partial name="_TablaObrasSocialesPartial" model="Model" />
    </div>
</div>

<partial name="_ModalCrud" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const filtroTexto = document.getElementById('filtroTexto');
        const filtroEstado = document.getElementById('filtroEstado');
        Crud.init({
            modalId: 'modalCrud', tablaId: 'contenedorTabla', entidad: 'obra social',
            eliminarUrl: '@Url.Action("Eliminar", "ObrasSociales")',
            listarUrl: () => '@Url.Action("ListarPartial", "ObrasSociales")?' + new URLSearchParams({ q: filtroTexto.value, estado: filtroEstado.value })
        });
        filtroTexto.addEventListener('input', conRetraso(Crud.refrescar));
        filtroEstado.addEventListener('change', Crud.refrescar);
    </script>
}
