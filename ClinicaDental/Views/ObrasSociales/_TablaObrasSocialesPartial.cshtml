@model IEnumerable<ObraSocial>

<table class="table table-hover mb-0">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Contacto</th>
            <th>Cobertura odontológica</th>
            <th>Convenio</th>
            <th class="text-center">Pacientes</th>
            <th>Auditoría</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="fw-semibold">@item.Nombre</td>
                <td class="small">
                    @(item.Telefono ?? "—")
                    @if (!string.IsNullOrEmpty(item.SitioWeb)) { <div class="text-muted">@item.SitioWeb</div> }
                </td>
                <td class="small text-muted" style="max-width: 280px">@(item.Cobertura ?? "—")</td>
                <td>
                    @if (item.Activa) { <span class="badge bg-success">Vigente</span> }
                    else { <span class="badge bg-secondary">Sin convenio</span> }
                </td>
                <td class="text-center"><span class="badge bg-info">@item.Pacientes.Count</span></td>
                <td><partial name="_CeldaAuditoria" model="item" /></td>
                <td class="text-end text-nowrap">
                    <button class="btn btn-sm btn-outline-warning me-1" title="Editar" aria-label="Editar"
                            onclick="Crud.abrir('@Url.Action("ObtenerFormulario", "ObrasSociales", new { id = item.Id })')">
                        <i class="bi bi-pencil"></i><span class="texto-accion"> Editar</span>
                    </button>
                    <button class="btn btn-sm btn-outline-danger" title="Eliminar" aria-label="Eliminar"
                            data-nombre="@item.Nombre"
                            onclick="Crud.eliminar(@item.Id, this.dataset.nombre)">
                        <i class="bi bi-trash"></i><span class="texto-accion"> Eliminar</span>
                    </button>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="7" class="text-center text-muted py-4">No se encontraron obras sociales.</td></tr>
        }
    </tbody>
</table>
