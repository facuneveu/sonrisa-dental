@model IEnumerable<LogAuditoria>

<table class="table table-hover mb-0">
    <thead>
        <tr>
            <th>Fecha</th>
            <th>Usuario</th>
            <th>Acción</th>
            <th>Registro</th>
            <th>Detalle</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var color = item.Accion switch
            {
                AccionAuditoria.Crear => "bg-success",
                AccionAuditoria.Eliminar => "bg-danger",
                _ => "bg-warning"
            };
            <tr>
                <td class="text-nowrap small">@Formato.FechaHora(item.Fecha)</td>
                <td class="fw-semibold">@item.UsuarioNombre</td>
                <td><span class="badge @color">@item.Accion</span></td>
                <td class="text-nowrap">@item.Entidad <span class="text-muted">#@item.EntidadId</span></td>
                <td class="small text-muted" style="max-width: 520px; word-break: break-word">@(item.Detalle ?? "—")</td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="5" class="text-center text-muted py-4">No hay movimientos para mostrar.</td></tr>
        }
    </tbody>
</table>
