@model IEnumerable<Paciente>
@{
    var hoy = ClinicaDental.Services.Reloj.Hoy;
    int Edad(DateOnly nac) => hoy.Year - nac.Year - (hoy < nac.AddYears(hoy.Year - nac.Year) ? 1 : 0);
}

<table class="table table-hover mb-0">
    <thead>
        <tr>
            <th>Paciente</th>
            <th>Contacto</th>
            <th>Obra social</th>
            <th>Estado</th>
            <th>Auditoría</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <div class="fw-semibold">@item.Usuario?.NombreCompleto</div>
                    <div class="small text-muted">DNI @item.Usuario?.Dni · @Edad(item.FechaNacimiento) años</div>
                    @if (!string.IsNullOrEmpty(item.Alergias)) { <div class="small"><span class="badge bg-warning"><i class="bi bi-exclamation-triangle"></i> @item.Alergias</span></div> }
                </td>
                <td class="small">
                    @item.Usuario?.Email
                    @if (!string.IsNullOrEmpty(item.Usuario?.PhoneNumber)) { <div class="text-muted">@item.Usuario.PhoneNumber</div> }
                </td>
                <td>
                    @if (item.ObraSocial != null)
                    {
                        <div>@item.ObraSocial.Nombre</div>
                        @if (!string.IsNullOrEmpty(item.NumeroAfiliado)) { <div class="small text-muted">Afiliado @item.NumeroAfiliado</div> }
                    }
                    else
                    {
                        <span class="text-muted">Particular</span>
                    }
                </td>
                <td>
                    @if (item.Usuario?.Activo == true) { <span class="badge bg-success">Activo</span> }
                    else { <span class="badge bg-secondary">Inactivo</span> }
                </td>
                <td><partial name="_CeldaAuditoria" model="item" /></td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-primary me-1" title="Ver sus turnos" aria-label="Ver sus turnos"
                       asp-controller="Turnos" asp-action="Index" asp-route-pacienteId="@item.Id" asp-route-periodo="todos">
                        <i class="bi bi-calendar2-week"></i><span class="texto-accion"> Turnos</span>
                    </a>
                    <button class="btn btn-sm btn-outline-warning me-1" title="Editar" aria-label="Editar"
                            onclick="Crud.abrir('@Url.Action("ObtenerFormulario", "Pacientes", new { id = item.Id })')">
                        <i class="bi bi-pencil"></i><span class="texto-accion"> Editar</span>
                    </button>
                    <button class="btn btn-sm btn-outline-danger" title="Eliminar" aria-label="Eliminar"
                            data-nombre="@item.Usuario?.NombreCompleto"
                            onclick="Crud.eliminar(@item.Id, this.dataset.nombre)">
                        <i class="bi bi-trash"></i><span class="texto-accion"> Eliminar</span>
                    </button>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="6" class="text-center text-muted py-4">No se encontraron pacientes.</td></tr>
        }
    </tbody>
</table>
