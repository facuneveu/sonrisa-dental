@model IEnumerable<Paciente>

@{
    ViewData["Title"] = "Pacientes";
}

@Html.AntiForgeryToken()

<div class="encabezado-pagina">
    <div>
        <h2>Pacientes</h2>
        <p>Personas registradas en la clínica, con su obra social y datos de contacto.</p>
    </div>
    <button type="button" class="btn btn-primary"
            onclick="Crud.abrir('@Url.Action("ObtenerFormulario", "Pacientes", new { id = 0 })')">
        <i class="bi bi-plus-lg"></i> Nuevo paciente
    </button>
</div>

<div class="row g-2 mb-3">
    <div class="col-md-5">
        <input id="filtroTexto" type="search" class="form-control" placeholder="Buscar por nombre, DNI o correo..." aria-label="Buscar paciente" />
    </div>
    <div class="col-md-4">
        <select id="filtroObra" class="form-select" aria-label="Filtrar por obra social">
            <option value="">Todas las obras sociales</option>
            <option value="-1">Particulares (sin obra social)</option>
            @foreach (var o in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.ObrasSociales)
            {
                <option value="@o.Value">@o.Text</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <select id="filtroEstado" class="form-select" aria-label="Filtrar por estado">
            <option value="">Activos e inactivos</option>
            <option value="activos">Solo activos</option>
            <option value="inactivos">Solo inactivos</option>
        </select>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0" id="contenedorTabla">
        <partial name="_TablaPacientesPartial" model="Model" />
    </div>
</div>

<partial name="_ModalCrud" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const filtroTexto = document.getElementById('filtroTexto');
        const filtroObra = document.getElementById('filtroObra');
        const filtroEstado = document.getElementById('filtroEstado');
        Crud.init({
            modalId: 'modalCrud', tablaId: 'contenedorTabla', entidad: 'paciente',
            eliminarUrl: '@Url.Action("Eliminar", "Pacientes")',
            listarUrl: () => '@Url.Action("ListarPartial", "Pacientes")?' +
                new URLSearchParams({ q: filtroTexto.value, obraSocialId: filtroObra.value, estado: filtroEstado.value })
        });
        filtroTexto.addEventListener('input', conRetraso(Crud.refrescar));
        filtroObra.addEventListener('change', Crud.refrescar);
        filtroEstado.addEventListener('change', Crud.refrescar);
    </script>
}
