@page
@model LoginModel

@{
    Layout = "/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Ingresar";
}

<form id="account" method="post">
    <h1>Ingresá a tu cuenta</h1>
    <p class="text-muted mb-4">Accedé para ver y gestionar tus turnos.</p>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

    <div class="form-floating mb-3">
        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nombre@ejemplo.com" />
        <label asp-for="Input.Email"></label>
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    <div class="form-floating mb-3">
        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="contraseña" />
        <label asp-for="Input.Password"></label>
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input class="form-check-input" asp-for="Input.RememberMe" />
        <label class="form-check-label" asp-for="Input.RememberMe"></label>
    </div>
    <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">Ingresar</button>

    <p class="mt-3 mb-0 text-center">
        ¿Todavía no tenés cuenta?
        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Registrate como paciente</a>
    </p>
</form>

@if (Model.MostrarCuentasDemo)
{
    <div class="card mt-4">
        <div class="card-body py-3">
            <div class="fw-bold mb-2"><i class="bi bi-key"></i> Cuentas de prueba</div>
            <p class="small text-muted mb-2">Datos ficticios para probar el sistema. Tocá una para completar el formulario.</p>
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary cuenta-demo" data-email="admin@clinica.com" data-clave="Admin123!">Administrador</button>
                <button type="button" class="btn btn-sm btn-outline-secondary cuenta-demo" data-email="odontologo@clinica.com" data-clave="Odonto123!">Odontólogo</button>
                <button type="button" class="btn btn-sm btn-outline-secondary cuenta-demo" data-email="paciente@clinica.com" data-clave="Paciente123!">Paciente</button>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.cuenta-demo').forEach(b => b.addEventListener('click', () => {
            document.getElementById('Input_Email').value = b.dataset.email;
            document.getElementById('Input_Password').value = b.dataset.clave;
            document.getElementById('login-submit').focus();
        }));
    </script>
}
