@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Acceso denegado";
}

<div class="card mx-auto" style="max-width: 560px">
    <div class="card-body text-center py-5">
        <div class="display-5 text-danger mb-3"><i class="bi bi-shield-lock"></i></div>
        <h2>Acceso denegado</h2>
        <p class="text-muted">Tu usuario no tiene permisos para ver esta sección.</p>
        <a class="btn btn-primary" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i> Volver al inicio</a>
    </div>
</div>
