@page
@model RegisterModel

@{
    Layout = "/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Crear cuenta";
}

<form asp-route-returnUrl="@Model.ReturnUrl" method="post">
    <h1>Creá tu cuenta</h1>
    <p class="text-muted mb-4">Registrate como paciente para sacar turnos online.</p>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

    <div class="row g-2">
        <div class="col-md-6">
            <div class="form-floating mb-2">
                <input asp-for="Input.Nombre" class="form-control" placeholder="Nombre" autocomplete="given-name" />
                <label asp-for="Input.Nombre"></label>
                <span asp-validation-for="Input.Nombre" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-floating mb-2">
                <input asp-for="Input.Apellido" class="form-control" placeholder="Apellido" autocomplete="family-name" />
                <label asp-for="Input.Apellido"></label>
                <span asp-validation-for="Input.Apellido" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-floating mb-2">
                <input asp-for="Input.Dni" type="number" class="form-control" placeholder="DNI" />
                <label asp-for="Input.Dni"></label>
                <span asp-validation-for="Input.Dni" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-floating mb-2">
                <input asp-for="Input.FechaNacimiento" type="date" value="@Model.Input?.FechaNacimiento?.ToString("yyyy-MM-dd")" class="form-control" max="@Model.Hoy.ToString("yyyy-MM-dd")" placeholder="Fecha de nacimiento" />
                <label asp-for="Input.FechaNacimiento"></label>
                <span asp-validation-for="Input.FechaNacimiento" class="text-danger"></span>
            </div>
        </div>
        <div class="col-12">
            <div class="form-floating mb-2">
                <input asp-for="Input.Telefono" type="tel" class="form-control" placeholder="Teléfono" autocomplete="tel" />
                <label asp-for="Input.Telefono"></label>
                <span asp-validation-for="Input.Telefono" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-7">
            <div class="form-floating mb-2">
                <select asp-for="Input.ObraSocialId" asp-items="Model.ObrasSociales" class="form-select">
                    <option value="">Particular (sin obra social)</option>
                </select>
                <label asp-for="Input.ObraSocialId"></label>
                <span asp-validation-for="Input.ObraSocialId" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-5">
            <div class="form-floating mb-2">
                <input asp-for="Input.NumeroAfiliado" class="form-control" placeholder="Nº de afiliado" />
                <label asp-for="Input.NumeroAfiliado"></label>
                <span asp-validation-for="Input.NumeroAfiliado" class="text-danger"></span>
            </div>
        </div>
        <div class="col-12">
            <div class="form-floating mb-2">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="nombre@ejemplo.com" />
                <label asp-for="Input.Email"></label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" placeholder="Contraseña" />
                <label asp-for="Input.Password"></label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-floating mb-3">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Confirmar contraseña" />
                <label asp-for="Input.ConfirmPassword"></label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="form-text mb-3">La contraseña debe tener al menos 6 caracteres e incluir un número.</div>

    <button type="submit" class="w-100 btn btn-lg btn-primary">Crear mi cuenta</button>
    <p class="mt-3 mb-0 text-center">
        ¿Ya tenés cuenta? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Ingresá acá</a>
    </p>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
